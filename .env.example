# ==============================================================================
# SuiMEV Liquidator - Environment Configuration
# ==============================================================================

# Network selection: 'mainnet' or 'testnet'
NETWORK=mainnet

# Primary Sui RPC HTTP Endpoint
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# Comma-separated fallback RPC HTTP Endpoints (automatic failover)
SUI_BACKUP_RPCS=https://sui-mainnet.nodeinfra.com,https://mainnet.sui.rpcpool.com,https://sui-mainnet-rpc.allthatnode.com

# Sui WebSocket RPC Endpoint for event streaming
SUI_WS_URL=wss://fullnode.mainnet.sui.io:443

# Pyth Network Hermes Service URL (for real-time price feeds and VAA updates)
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes

# Pyth API Key (required for live Hermes access as of August 2026, obtain via terminal.pyth.network)
# Leave blank for development/dry-run fallback cache
PYTH_API_KEY=

# Sentio Move Debugger & Tracing Service (https://app.sentio.xyz)
# Optional API key for direct program analysis and Move trace inspection
SENTIO_API_KEY=

# Operator Keypair (Ed25519)
# Format: bech32 private key ('suiprivkey1...'), hex (64 chars), or 32-byte Base64
SUI_PRIVATE_KEY=suiprivkey1qexampleprivatekeyreplacewithyourownkeyforproduction123

# Simulation & Safety Controls
# Set to 'true' to simulate liquidations via devInspect without broadcasting
DRY_RUN=true

# Strategy Thresholds
# Minimum net profit in USD required to execute a liquidation
MIN_PROFIT_USD=2.00

# Maximum slippage tolerance in basis points for DEX swaps (e.g., 100 = 1%)
MAX_SLIPPAGE_BPS=100

# Gas budget in MIST (1 SUI = 1,000,000,000 MIST)
GAS_BUDGET=50000000

# Priority Gas Price Multiplier (Base multiplier on Reference Gas Price: 1.15 = 15% tip)
GAS_PRICE_MULTIPLIER=1.15

# Maximum Gas Price Multiplier ceiling for high-profit Priority Gas Auctions (e.g. 5.0 = 5x RGP)
MAX_GAS_PRICE_MULTIPLIER=5.0

# Share of expected liquidation profit allocated to validator priority tip (0.20 = 20%)
PRIORITY_PROFIT_SHARE=0.20

# Liquidation Close Factor (max percentage of debt to liquidate, e.g. 0.50 = 50%)
LIQUIDATION_CLOSE_FACTOR=0.50

# Active Protocols to Monitor (comma-separated: navi,scallop)
PROTOCOLS=navi,scallop

# Preferred DEX for collateral liquidation swap (cetus, deepbook, or auto)
PREFERRED_DEX=cetus

# Polling Interval in milliseconds for indexer sweeps
POLL_INTERVAL_MS=3000

# Log Level: trace, debug, info, warn, error
LOG_LEVEL=info

